<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GymDiary.ApiClient</RootNamespace>

    <!-- Kiota generation inputs -->
    <KiotaOpenApiFile>$(MSBuildThisFileDirectory)..\..\artifacts\openapi\GymDiary.Api.json</KiotaOpenApiFile>
    <KiotaOutputDirectory>$(MSBuildThisFileDirectory)Generated</KiotaOutputDirectory>
    <KiotaClientClass>GymDiaryApiClient</KiotaClientClass>
    <KiotaClientNamespace>GymDiary.ApiClient.Generated</KiotaClientNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Kiota.Bundle" />
  </ItemGroup>

  <!-- Ensure the API has emitted a fresh OpenAPI document before we regenerate the client. -->
  <ItemGroup>
    <ProjectReference Include="..\GymDiary.Api\GymDiary.Api.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <IncludeAssets>none</IncludeAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!--
    Regenerate the Kiota client when the OpenAPI document or kiota-lock changes.
    Kiota short-circuits internally if the spec is unchanged (via kiota-lock.json).
    Run explicitly with: dotnet build -t:GenerateApiClient
  -->
  <Target Name="GenerateApiClient"
          BeforeTargets="CoreCompile"
          Inputs="$(KiotaOpenApiFile)"
          Outputs="$(KiotaOutputDirectory)\kiota-lock.json">
    <Error Condition="!Exists('$(KiotaOpenApiFile)')"
           Text="OpenAPI document not found at $(KiotaOpenApiFile). Build GymDiary.Api first." />
    <MakeDir Directories="$(KiotaOutputDirectory)" />
    <Exec Command="dotnet kiota generate --openapi &quot;$(KiotaOpenApiFile)&quot; --language CSharp --class-name $(KiotaClientClass) --namespace-name $(KiotaClientNamespace) --output &quot;$(KiotaOutputDirectory)&quot; --clean-output --clear-cache --log-level Warning"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\..\" />
  </Target>

  <Target Name="CleanApiClient" AfterTargets="Clean">
    <RemoveDir Directories="$(KiotaOutputDirectory)" />
  </Target>

</Project>
