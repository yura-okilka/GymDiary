# top-most EditorConfig file
root = true

# Default settings
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 130
insert_final_newline = true
trim_trailing_whitespace = true

# F# code style rules
[*.fs]
# Fantomas properties https://fsprojects.github.io/fantomas/docs/end-users/Configuration.html
fsharp_keep_max_number_of_blank_lines = 1
fsharp_max_dot_get_expression_width = 70 # Default = 80
fsharp_max_function_binding_width = 60 # Default = 40
fsharp_max_infix_operator_expression = 100 # Default = 80
fsharp_max_value_binding_width = 100 # Default = 80
fsharp_multiline_bracket_style = stroustrup
fsharp_newline_before_multiline_computation_expression = false

[*Handlers.fs]
max_line_length = 140

[src/GymDiary.Api/Router.fs]
max_line_length = 180
fsharp_max_infix_operator_expression = 180 # Default = 80

# C# code style rules
[*.cs]
# Microsoft .NET properties https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_elsewhere = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:warning
dotnet_separate_import_directive_groups = true
dotnet_sort_system_directives_first = true

# Rider properties https://www.jetbrains.com/help/rider/EditorConfig_Index.html
resharper_arguments_literal = named
resharper_arguments_skip_single = true
resharper_braces_redundant = true
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_wrap_after_declaration_lpar = true
resharper_csharp_wrap_after_invocation_lpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_before_declaration_rpar = true
resharper_csharp_wrap_before_invocation_rpar = true
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_place_accessorholder_attribute_on_same_line = false
resharper_place_field_attribute_on_same_line = false
resharper_wrap_before_primary_constructor_declaration_lpar = false
resharper_wrap_before_primary_constructor_declaration_rpar = true
resharper_wrap_lines = true

# Code quality rules
[*.{fs,cs}]

# Microsoft .NET inspection severities https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/
dotnet_diagnostic.CS1591.severity = none # Missing XML comment for publicly visible type or member
dotnet_diagnostic.CA1848.severity = suggestion # Use the LoggerMessage delegates
dotnet_diagnostic.CA2201.severity = suggestion # Do not raise reserved exception types

# Rider inspection severities https://www.jetbrains.com/help/rider/EditorConfig_Index.html
resharper_access_to_modified_closure_highlighting = suggestion
resharper_arguments_style_literal_highlighting = warning
resharper_class_never_instantiated_global_highlighting = hint
resharper_collection_never_updated_global_highlighting = suggestion
resharper_collection_never_updated_local_highlighting = suggestion
resharper_compare_of_floats_by_equality_operator_highlighting = suggestion
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting = suggestion
resharper_convert_to_primary_constructor_highlighting = hint
resharper_format_string_placeholders_mismatch_highlighting = suggestion
resharper_inconsistent_naming_highlighting = suggestion
resharper_localizable_element_highlighting = suggestion
resharper_member_can_be_made_static_global_highlighting = suggestion
resharper_member_can_be_made_static_local_highlighting = suggestion
resharper_possible_multiple_enumeration_highlighting = suggestion
resharper_redundant_argument_default_value_highlighting = suggestion
resharper_redundant_cast_highlighting = suggestion
resharper_redundant_type_arguments_of_method_highlighting = hint
resharper_unused_auto_property_accessor_global_highlighting = suggestion
resharper_unused_auto_property_accessor_local_highlighting = suggestion
resharper_unused_method_return_value_local_highlighting = suggestion
resharper_unused_parameter_local_highlighting = suggestion
resharper_unused_type_parameter_highlighting = suggestion

[**SystemTests**.cs]
dotnet_diagnostic.CA1707.severity = none # Identifiers should not contain underscores

resharper_inconsistent_naming_highlighting = hint

# Other files code style rules
[*.json]
indent_size = 2

[*.{xml,csproj,fsproj,props,targets}]
indent_size = 2
ij_xml_space_inside_empty_tag = true

[*.{yml,yaml}]
indent_size = 2

[*.{http,rest}]
indent_size = 0
